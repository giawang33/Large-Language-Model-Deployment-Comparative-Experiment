al="zh-CN"/></w:rPr><w:t>，直接从</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>“</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>答题者</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>”</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>变成了</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>“</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>出卷人</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>”</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>。</w:t></w:r></w:p><w:p w14:paraId="0BE64D49" w14:textId="77777777" w:rsidR="00FA5037" w:rsidRPr="00FB4748" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="a0"/><w:rPr><w:lang w:val="zh-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>ChatGLM3-6B</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:rFonts w:hint="eastAsia"/><w:lang w:val="zh-CN"/></w:rPr><w:t>的</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>意图识别最为稳定，没有出现续写或格式幻觉，能够老老实实地扮演回答者的角色进行逐条作答。</w:t></w:r></w:p><w:p w14:paraId="43E6BFFF" w14:textId="77777777" w:rsidR="00FA5037" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="2"/><w:spacing w:beforeLines="50" w:before="120" w:afterLines="50" w:after="120" w:line="360" w:lineRule="exact"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="黑体" w:hAnsi="Arial" w:cs="Arial"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr></w:pPr><w:bookmarkStart w:id="14" w:name="溶液的配制及浓度的测定"/><w:bookmarkStart w:id="15" w:name="_Toc261510885"/><w:bookmarkStart w:id="16" w:name="_Toc402184276"/><w:r><w:rPr><w:rFonts w:eastAsia="黑体"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr><w:t>3.2</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="黑体" w:hAnsi="Arial" w:cs="Arial"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:bookmarkEnd w:id="14"/><w:bookmarkEnd w:id="15"/><w:bookmarkEnd w:id="16"/><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="黑体" w:hAnsi="Arial" w:cs="Arial" w:hint="eastAsia"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr><w:t>复杂中文语义与语境解析</w:t></w:r></w:p><w:p w14:paraId="3DDFC73F" w14:textId="77777777" w:rsidR="00FA5037" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="a0"/></w:pPr><w:r><w:t>面对中文特有的语境依赖和幽默感，各模型表现出明显的算力与参数瓶颈：</w:t></w:r></w:p><w:p w14:paraId="14E14485" w14:textId="77777777" w:rsidR="00FA5037" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="a0"/></w:pPr><w:r><w:t>同音异义与断句（明明和白白）：三个模型</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>均没有得出正确答案</w:t></w:r><w:r><w:t>。</w:t></w:r><w:r><w:t xml:space="preserve">Qwen-7B </w:t></w:r><w:r><w:t>逻辑反转</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>，</w:t></w:r><w:r><w:t>得出明明喜欢白白；</w:t></w:r><w:r><w:t xml:space="preserve">ChatGLM3-6B </w:t></w:r><w:r><w:t>直接复读机式重复题目并得出错误结论；</w:t></w:r><w:r><w:t xml:space="preserve">Baichuan2-7B </w:t></w:r><w:r><w:t>则直接放弃，回答</w:t></w:r><w:r><w:t>“</w:t></w:r><w:r><w:t>无法确定是谁喜欢谁</w:t></w:r><w:r><w:t>”</w:t></w:r><w:r><w:t>。说明轻量级模型在缺乏标点符号辅助时，分词器极易发生词性标注错误。</w:t></w:r></w:p><w:p w14:paraId="2FC5FD71" w14:textId="77777777" w:rsidR="00FA5037" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="a0"/></w:pPr><w:r><w:t>多义词消歧（意思意思）</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>：</w:t></w:r><w:r><w:t xml:space="preserve">ChatGLM3-6B </w:t></w:r><w:r><w:t>表现最佳。它成功地将一段长对话按句拆解，并准确识别出了</w:t></w:r><w:r><w:t>“</w:t></w:r><w:r><w:t>目的、小事情、赞赏、态度</w:t></w:r><w:r><w:t>”</w:t></w:r><w:r><w:t>等不同语境下的</w:t></w:r><w:r><w:t>“</w:t></w:r><w:r><w:t>意思</w:t></w:r><w:r><w:t>”</w:t></w:r><w:r><w:t>含义；而</w:t></w:r><w:r><w:t xml:space="preserve"> Baichuan2-7B </w:t></w:r><w:r><w:t>彻底崩溃变成了出题机。</w:t></w:r></w:p><w:p w14:paraId="0B109A6C" w14:textId="77777777" w:rsidR="00FA5037" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="a0"/></w:pPr><w:r><w:t>幽默感与反转语义（冬天和夏天）：</w:t></w:r><w:r><w:t xml:space="preserve">ChatGLM3-6B </w:t></w:r><w:r><w:t>表现出典型的</w:t></w:r><w:r><w:t>“</w:t></w:r><w:r><w:t>废话文学</w:t></w:r><w:r><w:t>”</w:t></w:r><w:r><w:t>特征，给出了</w:t></w:r><w:r><w:t>“</w:t></w:r><w:r><w:t>一句是关于冬天，一句是关于夏天</w:t></w:r><w:r><w:t>”</w:t></w:r><w:r><w:t>这类机械的字面拆解，完全未能捕捉到</w:t></w:r><w:r><w:t>“</w:t></w:r><w:r><w:t>多</w:t></w:r><w:r><w:t>”</w:t></w:r><w:r><w:t>与</w:t></w:r><w:r><w:t>“</w:t></w:r><w:r><w:t>少</w:t></w:r><w:r><w:t>”</w:t></w:r><w:r><w:t>在不同季节语境下的幽默暗示。</w:t></w:r></w:p><w:p w14:paraId="1E11BDA4" w14:textId="77777777" w:rsidR="00FA5037" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="2"/><w:spacing w:beforeLines="50" w:before="120" w:afterLines="50" w:after="120" w:line="360" w:lineRule="exact"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="黑体" w:hAnsi="Arial" w:cs="Arial"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr></w:pPr><w:bookmarkStart w:id="17" w:name="_Toc261510888"/><w:bookmarkStart w:id="18" w:name="_Toc402184279"/><w:bookmarkStart w:id="19" w:name="酸的配制及浓度标定"/><w:r><w:rPr><w:rFonts w:eastAsia="黑体"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr><w:t>3.3</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="黑体" w:hAnsi="Arial" w:cs="Arial"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:bookmarkEnd w:id="17"/><w:bookmarkEnd w:id="18"/><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="黑体" w:hAnsi="Arial" w:cs="Arial" w:hint="eastAsia"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr><w:t>逻辑推理与指代消解</w:t></w:r></w:p><w:p w14:paraId="29A50BC7" w14:textId="77777777" w:rsidR="00FA5037" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="a0"/></w:pPr><w:r><w:t>在测试代词嵌套的逻辑绕口令（</w:t></w:r><w:r><w:t>“</w:t></w:r><w:r><w:t>他知道我知道你知道他不知道吗</w:t></w:r><w:r><w:t>”</w:t></w:r><w:r><w:t>）和</w:t></w:r><w:r><w:t>“</w:t></w:r><w:r><w:t>单身狗</w:t></w:r><w:r><w:t>”</w:t></w:r><w:r><w:t>测试中：</w:t></w:r></w:p><w:p w14:paraId="5D247364" w14:textId="77777777" w:rsidR="00FA5037" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="a0"/></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t xml:space="preserve">ChatGLM3-6B </w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>试图建立逻辑链条，但迅速陷入死循环。解释为到底谁不知道的事情是他不知道的事情，无法厘清“我、你、他”的认知边界。</w:t></w:r></w:p><w:p w14:paraId="714AA052" w14:textId="77777777" w:rsidR="00FA5037" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="a0"/></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t xml:space="preserve">Baichuan2-7B </w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>同样在多重代词指代中迷失，输出了“他和你好都不知道对方所知道的信息”这种毫无逻辑支撑的拼凑结论。</w:t></w:r></w:p><w:p w14:paraId="10FCB25A" w14:textId="77777777" w:rsidR="00FA5037" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="a0"/></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>这印证了在百亿参数以下的大模型中，复杂逻辑推理能力仍是极其薄弱的环节。</w:t></w:r></w:p><w:p w14:paraId="2084A369" w14:textId="77777777" w:rsidR="00FA5037" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="2"/><w:spacing w:beforeLines="50" w:before="120" w:afterLines="50" w:after="120" w:line="360" w:lineRule="exact"/><w:rPr><w:rFonts w:eastAsia="黑体"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:eastAsia="黑体" w:hint="eastAsia"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr><w:t xml:space="preserve">3.4 </w:t></w:r><w:r><w:rPr><w:rFonts w:eastAsia="黑体" w:hint="eastAsia"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr><w:t>综合总结评价</w:t></w:r></w:p><w:p w14:paraId="622A276D" w14:textId="77777777" w:rsidR="00FA5037" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="a0"/><w:rPr><w:lang w:val="zh-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>ChatGLM3-6B</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:lang w:val="zh-CN"/></w:rPr><w:t>的</w:t></w:r><w:r><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>结构化拆解能力最强，态度最严谨，但在幽默感和深度逻辑上稍显死板。</w:t></w:r></w:p><w:p w14:paraId="19E20F52" w14:textId="77777777" w:rsidR="00FA5037" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="a0"/><w:rPr><w:lang w:val="zh-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>Qwen-7B</w:t></w:r><w:r><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>具有一定的灵气和语境理解力，但极其容易受到训练语料的格式反噬，产生严重的</w:t></w:r><w:r><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:lastRenderedPageBreak/><w:t>格式幻觉。</w:t></w:r></w:p><w:p w14:paraId="2A277E78" w14:textId="4E2C4C66" w:rsidR="00FA5037" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="a0"/><w:rPr><w:lang w:val="zh-CN"/></w:rPr></w:pPr><w:r><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>Baichuan2-7B</w:t></w:r><w:r><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>在本次裸提示词环境下的鲁棒性最差，极易发生文本续写的身份错乱，对指令的格式要求最为苛刻。</w:t></w:r></w:p><w:p w14:paraId="1EEE744A" w14:textId="77777777" w:rsidR="00FA5037" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="a0"/><w:rPr><w:lang w:val="zh-CN"/></w:rPr></w:pPr><w:r><w:t>这也从侧面反映出，我们在商业</w:t></w:r><w:r><w:t xml:space="preserve"> App </w:t></w:r><w:r><w:t>中体验到的高度智能，不仅来源于模型参数量的庞大，更依赖于后端复杂的</w:t></w:r><w:r><w:t xml:space="preserve"> Prompt Engineering</w:t></w:r><w:r><w:t>和强大的</w:t></w:r><w:r><w:t xml:space="preserve"> GPU </w:t></w:r><w:r><w:t>算力支撑。</w:t></w:r></w:p><w:p w14:paraId="0FC6696A" w14:textId="77777777" w:rsidR="00FA5037" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="1"/><w:spacing w:beforeLines="50" w:before="120" w:afterLines="50" w:after="120" w:line="360" w:lineRule="exact"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="黑体" w:hAnsi="Arial" w:cs="Arial"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr></w:pPr><w:bookmarkStart w:id="20" w:name="_Toc261510889"/><w:bookmarkStart w:id="21" w:name="_Toc402184280"/><w:bookmarkEnd w:id="19"/><w:r><w:rPr><w:rFonts w:eastAsia="黑体"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr><w:t>4</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="黑体" w:hAnsi="Arial" w:cs="Arial"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr><w:t xml:space="preserve">  </w:t></w:r><w:bookmarkEnd w:id="20"/><w:bookmarkEnd w:id="21"/><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="黑体" w:hAnsi="Arial" w:cs="Arial" w:hint="eastAsia"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr><w:t>实验总结</w:t></w:r></w:p><w:p w14:paraId="4C00D667" w14:textId="77777777" w:rsidR="00FA5037" w:rsidRPr="00FB4748" w:rsidRDefault="00000000" w:rsidP="00FB4748"><w:pPr><w:pStyle w:val="a0"/><w:spacing w:beforeLines="50" w:before="120"/><w:rPr><w:lang w:val="zh-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>通过本次大语言模型的本地部署实验，我不仅掌握了在云端</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>Linux</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>环境下配置运行环境、下载模型和运行代码的基本操作，也直观感受到了不同模型在处理复杂中文时的实际能力。在测试环节，我发现用</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>“</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>明明和白白</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>”</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>或者多义词这种需要结合日常语境来理解的题目去提问，能很真实地反映出模型在语义分析和逻辑判断上的短板。这让我意识到，日常使用的</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>AI</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>之所以显得聪明，不单单是因为参数量大，还需要在训练语料和交互设计上做很多配合。</w:t></w:r></w:p><w:p w14:paraId="7A9ED5C1" w14:textId="77777777" w:rsidR="00FA5037" w:rsidRPr="00FB4748" w:rsidRDefault="00000000" w:rsidP="00FB4748"><w:pPr><w:pStyle w:val="a0"/><w:spacing w:beforeLines="50" w:before="120"/><w:rPr><w:lang w:val="zh-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>在动手实践的过程中，我遇到的一个非常实际的问题是网络下载速度。大模型的文件动辄十几个</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>G</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>，在安装底层运行库或者克隆模型仓库时，如果直接下载，速度会非常慢，还很容易因为超时而中断报错。后来我</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:rFonts w:hint="eastAsia"/><w:lang w:val="zh-CN"/></w:rPr><w:t>尝试</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>使用了国内的阿里云镜像源，无论是配置环境还是拉取模型，速度都得到了大幅提升，整个过程变得非常顺畅。这让我学到了在实际的项目部署中，合理配置镜像源是提高开发效率非常重要的一步。</w:t></w:r></w:p><w:p w14:paraId="163B9DE3" w14:textId="77777777" w:rsidR="00FA5037" w:rsidRPr="00FB4748" w:rsidRDefault="00000000" w:rsidP="00FB4748"><w:pPr><w:pStyle w:val="a0"/><w:spacing w:beforeLines="50" w:before="120"/><w:rPr><w:lang w:val="zh-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>另一个让我印象深刻的体验是纯</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>CPU</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>环境下模型运行速度的局限性。在跑测试代码时，模型加载经常需要花一分钟，输出答案时也是一个字一个字地缓慢生成</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:rFonts w:hint="eastAsia"/><w:lang w:val="zh-CN"/></w:rPr><w:t>，整个过程下来平均一个问题要耗时近</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:rFonts w:hint="eastAsia"/><w:lang w:val="zh-CN"/></w:rPr><w:t>5-7</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:rFonts w:hint="eastAsia"/><w:lang w:val="zh-CN"/></w:rPr><w:t>分钟</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>。</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:rFonts w:hint="eastAsia"/><w:lang w:val="zh-CN"/></w:rPr><w:t>而</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>这是</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:rFonts w:hint="eastAsia"/><w:lang w:val="zh-CN"/></w:rPr><w:t>由于</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>大语言模型在推理时需要进行海量的矩阵计算，</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:rFonts w:hint="eastAsia"/><w:lang w:val="zh-CN"/></w:rPr><w:t>但</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>CPU</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>的架构并不擅长处理这种并发任务。这</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:rFonts w:hint="eastAsia"/><w:lang w:val="zh-CN"/></w:rPr><w:t>也</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>让我从底层硬件的角度彻底明白了为什么目前主流的</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>AI</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>大模型应用都必须依赖昂贵的</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>GPU</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>算力集群，才能保证给用户提供秒级的流畅回复。</w:t></w:r></w:p><w:p w14:paraId="5AB12860" w14:textId="77777777" w:rsidR="00FA5037" w:rsidRPr="00FB4748" w:rsidRDefault="00000000" w:rsidP="00FB4748"><w:pPr><w:pStyle w:val="a0"/><w:spacing w:beforeLines="50" w:before="120"/><w:rPr><w:lang w:val="zh-CN"/></w:rPr></w:pPr><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>最后，我还发现这些开源模型在本地终端里的表现，往往没有它们在官方</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>App</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>里那么聪明，有时甚至会弄错身份，顺着题目继续往下编造内容。经过查阅资料我明白了，我们在本地测试时输入的是最原始的文字，而官方应用在后台不仅会调用参数量更大的旗舰版模型，还会自动给用户的提问加上标准的</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>“</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>对话模板</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>”</w:t></w:r><w:r w:rsidRPr="00FB4748"><w:rPr><w:lang w:val="zh-CN"/></w:rPr><w:t>和复杂的系统提示词。这让我体会到，一个成熟的人工智能产品，除了需要优秀的底层模型，外围的软件工程包装和提示词优化同样必不可少。</w:t></w:r></w:p><w:p w14:paraId="74BBBD07" w14:textId="7D788527" w:rsidR="00CA48F2" w:rsidRPr="00CA48F2" w:rsidRDefault="00CA48F2" w:rsidP="00CA48F2"><w:pPr><w:pStyle w:val="1"/><w:spacing w:beforeLines="50" w:before="120" w:afterLines="50" w:after="120" w:line="360" w:lineRule="exact"/><w:jc w:val="center"/><w:rPr><w:rFonts w:eastAsia="黑体"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:eastAsia="黑体" w:hint="eastAsia"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr><w:t>5</w:t></w:r><w:r w:rsidRPr="00CA48F2"><w:rPr><w:rFonts w:eastAsia="黑体"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:rFonts w:eastAsia="黑体" w:hint="eastAsia"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r w:rsidRPr="00CA48F2"><w:rPr><w:rFonts w:eastAsia="黑体"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr><w:t>项目可访问链接</w:t></w:r></w:p><w:p w14:paraId="614F98D2" w14:textId="77777777" w:rsidR="00CA48F2" w:rsidRPr="00CA48F2" w:rsidRDefault="00CA48F2" w:rsidP="00CA48F2"><w:pPr><w:numPr><w:ilvl w:val="0"/><w:numId w:val="2"/></w:numPr><w:spacing w:line="360" w:lineRule="exact"/><w:rPr><w:bCs/></w:rPr></w:pPr><w:r w:rsidRPr="00CA48F2"><w:rPr><w:bCs/></w:rPr><w:t>https://github.com/giawang33/Large-Language-Model-Deployment-Comparative-Experiment.git</w:t></w:r></w:p><w:p w14:paraId="14EF448E" w14:textId="77777777" w:rsidR="00FA5037" w:rsidRPr="00CA48F2" w:rsidRDefault="00FA5037"><w:pPr><w:spacing w:line="360" w:lineRule="exact"/></w:pPr></w:p><w:sectPr w:rsidR="00FA5037" w:rsidRPr="00CA48F2"><w:headerReference w:type="default" r:id="rId29"/><w:footerReference w:type="default" r:id="rId30"/><w:pgSz w:w="11907" w:h="16840"/><w:pgMar w:top="1361" w:right="1134" w:bottom="1361" w:left="1134" w:header="720" w:footer="851" w:gutter="851"/><w:pgNumType w:start="1"/><w:cols w:space="720"/></w:sectPr></w:body></w:document></pkg:xmlData></pkg:part><pkg:part pkg:name="/word/_rels/document.xml.rels" pkg:contentType="application/vnd.openxmlformats-package.relationships+xml" pkg:padding="256"><pkg:xmlData><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId8" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/endnotes" Target="endnotes.xml"/><Relationship Id="rId13" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/image" Target="media/image5.png"/><Relationship Id="rId18" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/image" Target="media/image10.png"/><Relationship Id="rId26" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/image" Target="media/image18.png"/><Relationship Id="rId3" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/numbering" Target="numbering.xml"/><Relationship Id="rId21" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/image" Target="media/image13.png"/><Relationship Id="rId7" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/footnotes" Target="footnotes.xml"/><Relationship Id="rId12" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/image" Target="media/image4.png"/><Relationship Id="rId17" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/image" Target="media/image9.png"/><Relationship Id="rId25" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/image" Target="media/image17.png"/><Relationship Id="rId2" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/customXml" Target="../customXml/item2.xml"/><Relationship Id="rId16" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/image" Target="media/image8.png"/><Relationship Id="rId20" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/image" Target="media/image12.png"/><Relationship Id="rId29" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/header" Target="header1.xml"/><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/customXml" Target="../customXml/item1.xml"/><Relationship Id="rId6" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/webSettings" Target="webSettings.xml"/><Relationship Id="rId11" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/image" Target="media/image3.png"/><Relationship Id="rId24" Type="http://schemas.openxmlformats.org/officeDocume