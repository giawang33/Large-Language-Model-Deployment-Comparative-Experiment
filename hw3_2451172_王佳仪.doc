<w:instrText xml:space="preserve"> \* ARABIC </w:instrText></w:r><w:r><w:fldChar w:fldCharType="separate"/></w:r><w:r><w:t>3</w:t></w:r><w:r><w:fldChar w:fldCharType="end"/></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>拉取</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t xml:space="preserve">Qwen-7B-Chat </w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>模型</w:t></w:r></w:p></w:txbxContent></v:textbox><w10:wrap type="topAndBottom"/></v:shape></w:pict></w:r><w:r><w:pict w14:anchorId="38E6A785"><v:shape id="_x0000_s2197" type="#_x0000_t75" alt="capture_20260505003542837" style="position:absolute;left:0;text-align:left;margin-left:.35pt;margin-top:58.55pt;width:439.1pt;height:86.75pt;z-index:5;mso-wrap-distance-top:0;mso-wrap-distance-bottom:0;mso-width-relative:page;mso-height-relative:page"><v:imagedata r:id="rId13" o:title="capture_20260505003542837"/><w10:wrap type="topAndBottom"/></v:shape></w:pict></w:r><w:r w:rsidR="00FB4748" w:rsidRPr="00FB4748"><w:t>环境部署完成后，实验进入</w:t></w:r><w:r w:rsidR="00FB4748" w:rsidRPr="00FB4748"><w:t xml:space="preserve"> /mnt/workspace </w:t></w:r><w:r w:rsidR="00FB4748" w:rsidRPr="00FB4748"><w:t>目录。使用平台官方提供的</w:t></w:r><w:r w:rsidR="00FB4748" w:rsidRPr="00FB4748"><w:t xml:space="preserve"> git clone </w:t></w:r><w:r w:rsidR="00FB4748" w:rsidRPr="00FB4748"><w:t>命令，依次从</w:t></w:r><w:r w:rsidR="00FB4748" w:rsidRPr="00FB4748"><w:t xml:space="preserve"> ModelScope </w:t></w:r><w:r w:rsidR="00FB4748" w:rsidRPr="00FB4748"><w:t>的官方代码库中拉取了本次实验所需测试的三个开源大语言模型：通义千问（</w:t></w:r><w:r w:rsidR="00FB4748" w:rsidRPr="00FB4748"><w:t>Qwen-7B-Chat</w:t></w:r><w:r w:rsidR="00FB4748" w:rsidRPr="00FB4748"><w:t>）、智谱（</w:t></w:r><w:r w:rsidR="00FB4748" w:rsidRPr="00FB4748"><w:t>ChatGLM3-6B</w:t></w:r><w:r w:rsidR="00FB4748" w:rsidRPr="00FB4748"><w:t>）以及百川（</w:t></w:r><w:r w:rsidR="00FB4748" w:rsidRPr="00FB4748"><w:t>Baichuan2-7B-Chat</w:t></w:r><w:r w:rsidR="00FB4748" w:rsidRPr="00FB4748"><w:t>）。为避免云盘存储空间超载报错，实验</w:t></w:r><w:r w:rsidR="00FB4748" w:rsidRPr="00FB4748"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>在</w:t></w:r><w:r w:rsidR="00FB4748" w:rsidRPr="00FB4748"><w:t>测试完</w:t></w:r><w:r w:rsidR="00FB4748" w:rsidRPr="00FB4748"><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>一个模型</w:t></w:r><w:r w:rsidR="00FB4748" w:rsidRPr="00FB4748"><w:t>后清理空间再拉取下一个模型。</w:t></w:r><w:bookmarkStart w:id="0" w:name="_Toc261510875"/><w:bookmarkStart w:id="1" w:name="_Toc402184266"/><w:bookmarkStart w:id="2" w:name="理论部分"/></w:p><w:p w14:paraId="2D277441" w14:textId="6586CA8C" w:rsidR="00FA5037" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="1"/><w:spacing w:beforeLines="150" w:before="360" w:afterLines="50" w:after="120" w:line="360" w:lineRule="exact"/><w:jc w:val="center"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="黑体" w:hAnsi="Arial" w:cs="Arial"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:eastAsia="黑体"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr><w:t>2</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="黑体" w:hAnsi="Arial" w:cs="Arial"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr><w:t xml:space="preserve">  </w:t></w:r><w:bookmarkEnd w:id="0"/><w:bookmarkEnd w:id="1"/><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="黑体" w:hAnsi="Arial" w:cs="Arial" w:hint="eastAsia"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr><w:t>问答测试结果</w:t></w:r></w:p><w:p w14:paraId="5DA39FBA" w14:textId="77777777" w:rsidR="00FA5037" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="2"/><w:spacing w:beforeLines="50" w:before="120" w:afterLines="50" w:after="120" w:line="360" w:lineRule="exact"/><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="黑体" w:hAnsi="Arial" w:cs="Arial"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr></w:pPr><w:bookmarkStart w:id="3" w:name="_Toc261510876"/><w:bookmarkStart w:id="4" w:name="_Toc402184267"/><w:bookmarkStart w:id="5" w:name="生成函数法测定稳定常数关系式的导出"/><w:bookmarkEnd w:id="2"/><w:r><w:rPr><w:rFonts w:eastAsia="黑体"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr><w:t>2.1</w:t></w:r><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="黑体" w:hAnsi="Arial" w:cs="Arial"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr><w:t xml:space="preserve"> </w:t></w:r><w:bookmarkEnd w:id="3"/><w:bookmarkEnd w:id="4"/><w:r><w:rPr><w:rFonts w:ascii="Arial" w:eastAsia="黑体" w:hAnsi="Arial" w:cs="Arial" w:hint="eastAsia"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr><w:t>问题设计</w:t></w:r></w:p><w:p w14:paraId="278EF9C1" w14:textId="77777777" w:rsidR="00FA5037" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="a0"/></w:pPr><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:lang w:val="zh-CN"/></w:rPr><w:t>在本次测试中，为了深度考察大语言模型的底层语义解析能力，</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>实验</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:lang w:val="zh-CN"/></w:rPr><w:t>选取了</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>补充材料</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>2</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>中</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:lang w:val="zh-CN"/></w:rPr><w:t>难度较高的中文语境题。题目包含了多义词消歧、同音字断句陷阱、逻辑代词嵌套以及反转语境</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>等</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:lang w:val="zh-CN"/></w:rPr><w:t>。旨在测试轻量级模型在缺乏复杂微调和前置对话模板时，对人类真实复杂语境的理解与指令遵循能力。</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr><w:t>具体测试题目如下：</w:t></w:r></w:p><w:p w14:paraId="497E343E" w14:textId="77777777" w:rsidR="00FA5037" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="msolistparagraph0"/><w:widowControl/><w:numPr><w:ilvl w:val="0"/><w:numId w:val="1"/></w:numPr><w:ind w:firstLineChars="0"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="宋体" w:hAnsi="Times New Roman" w:hint="default"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="宋体" w:hAnsi="Times New Roman"/></w:rPr><w:t>请说出以下两句话区别在哪里？</w:t></w:r><w