rType="separate"/></w:r><w:r><w:rPr><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>1</w:t></w:r><w:r><w:rPr><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:fldChar w:fldCharType="end"/></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>手动下载并成功配置</w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t xml:space="preserve"> Miniconda </w:t></w:r><w:r><w:rPr><w:rFonts w:hint="eastAsia"/><w:sz w:val="18"/><w:szCs w:val="18"/></w:rPr><w:t>虚拟环境</w:t></w:r></w:p></w:txbxContent></v:textbox><w10:wrap type="topAndBottom"/></v:shape></w:pict></w:r><w:r><w:pict w14:anchorId="3E00CD26"><v:shape id="_x0000_s2193" type="#_x0000_t75" alt="" style="position:absolute;left:0;text-align:left;margin-left:-10.15pt;margin-top:5.8pt;width:477.85pt;height:212.35pt;z-index:1;mso-wrap-distance-top:0;mso-wrap-distance-bottom:0;mso-width-relative:page;mso-height-relative:page"><v:imagedata r:id="rId10" o:title=""/><w10:wrap type="topAndBottom"/></v:shape></w:pict></w:r><w:r w:rsidR="00FB4748"><w:t>为了适配纯</w:t></w:r><w:r w:rsidR="00FB4748"><w:t xml:space="preserve"> CPU </w:t></w:r><w:r w:rsidR="00FB4748"><w:t>的算力环境并解决网络超时问题，实验中使用了阿里云国内镜像源（</w:t></w:r><w:r w:rsidR="00FB4748"><w:t>mirrors.aliyun.com</w:t></w:r><w:r w:rsidR="00FB4748"><w:t>），精简并显式指定了</w:t></w:r><w:r w:rsidR="00FB4748"><w:t xml:space="preserve"> PyTorch (2.3.0+cpu)</w:t></w:r><w:r w:rsidR="00FB4748"><w:t>、</w:t></w:r><w:r w:rsidR="00FB4748"><w:t xml:space="preserve">Transformers (4.37.2) </w:t></w:r><w:r w:rsidR="00FB4748"><w:t>以及</w:t></w:r><w:r w:rsidR="00FB4748"><w:t xml:space="preserve"> sentencepiece </w:t></w:r><w:r w:rsidR="00FB4748"><w:t>等核心基础包，成功解决了本地环境配置中的依赖冲突与包缺失问题，完成了模型的底层运行环境部署。</w:t></w:r></w:p><w:p w14:paraId="27FB92FD" w14:textId="7AA5C167" w:rsidR="00FA5037" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="a0"/><w:rPr><w:rFonts w:hint="eastAsia"/></w:rPr></w:pPr><w:r><w:pict w14:anchorId="75B476BA"><v:shape id="_x000