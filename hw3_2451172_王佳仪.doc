><w:r><w:t>云计算资源。整体部署过程通过</w:t></w:r><w:r><w:t xml:space="preserve"> Jupyter Notebook </w:t></w:r><w:r><w:t>提供的终端环境完成，具体步骤如下：</w:t></w:r></w:p><w:p w14:paraId="2C147B9F" w14:textId="77777777" w:rsidR="00FA5037" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="2"/><w:spacing w:beforeLines="50" w:before="120" w:afterLines="50" w:after="120" w:line="360" w:lineRule="exact"/><w:rPr><w:rFonts w:eastAsia="黑体"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:eastAsia="黑体" w:hint="eastAsia"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr><w:t xml:space="preserve">1.1 </w:t></w:r><w:r><w:rPr><w:rFonts w:eastAsia="黑体"/><w:b w:val="0"/><w:i w:val="0"/></w:rPr><w:t>部署与基础环境配置</w:t></w:r></w:p><w:p w14:paraId="44991CDC" w14:textId="77777777" w:rsidR="00FA5037" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="a0"/></w:pPr><w:r><w:t>本次实验首先通过系统终端安装了</w:t></w:r><w:r><w:t xml:space="preserve"> Miniconda</w:t></w:r><w:r><w:t>，并创建了名为</w:t></w:r><w:r><w:t xml:space="preserve"> qwen_env </w:t></w:r><w:r><w:t>的</w:t></w:r><w:r><w:t xml:space="preserve"> Python 3.10 </w:t></w:r><w:r><w:t>虚拟环境。</w:t></w:r></w:p><w:p w14:paraId="123DE2E4" w14:textId="43F994F0" w:rsidR="00FA5037" w:rsidRDefault="00000000"><w:pPr><w:pStyle w:val="a0"/><w:spacing w:beforeLines="50" w:before="120" w:afterLines="50" w:after="120"/></w:pPr><w:r><w:pict w14:anchorId="39C3E87D"><v:shapetype id="_x0000_t75" coordsize="21600,21600" o:spt="75" o:preferrelative="t" path="m@4@5l@4@11@9@11@9@5xe" filled="f" stroked="f"><v:stroke joinstyle="miter"/><v:formulas><v:f eqn="if lineDrawn pixelLineWidth 0"/><v:f eqn="sum @0 1 0"/><v:f eqn="sum 0 0 @1"/><v:f eqn="prod @2 1 2"/><v:f eqn="prod @3 21600 pixelWidth"/><v:f eqn="prod @3 21600 pixelHeight"/><v:f eqn="sum @0 0 1"/><v:f eqn="prod @6 1 2"/><v:f eqn="prod @7 21600 pixelWidth"/><v:f eqn="sum @8 21600 0"/><v:f eqn="prod @7 21600 pixelHeight"/><v:f eqn="sum @10 21600 0"/></v:formulas><v:path o:extrusionok="f" gradientshapeok="t" o:connecttype="rect"/><o:lock 